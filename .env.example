# Copie para .env e ajuste. Nenhuma chave de API é necessária: tudo roda localmente.
# Valores comentados são os padrões usados quando a variável não existe.

# --- Modelos (compose.yaml) ---
# Pasta com os arquivos .gguf (ver README para baixar)
MODELOS_DIR=./modelos
# LLM_GGUF=Qwen3-30B-A3B-Instruct-2507-UD-Q2_K_XL.gguf
# EMBEDDING_GGUF=Qwen3-Embedding-0.6B-Q8_0.gguf
# LLM_THREADS=4
# LLM_CONTEXTO=16384

# --- LLM ---
# llamacpp (padrão, compose.yaml) | localai | ollama
# LLM_PROVIDER=llamacpp
# LLM_BASE_URL=http://localhost:8091/v1
# LLM_MODEL=qwen3-30b
# LLM_TIMEOUT=300
# LLM_MAX_RETRIES=1
# LLM_DESATIVAR_RACIOCINIO=true

# --- Embeddings e pgvector ---
# EMBEDDING_BASE_URL=http://localhost:8092/v1
# EMBEDDING_MODEL=qwen3-embedding-0.6b
# EMBEDDING_DIMENSOES=1024
# PG_DSN=postgresql://horizonte:horizonte@localhost:5434/horizonte

